{
  "$defs": {
    "CallerHeader": {
      "pattern": "^[^/]+/[^/]+$",
      "type": "string"
    },
    "ContextHeader": {
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "HookInvocation": {
      "additionalProperties": false,
      "properties": {
        "app": {
          "type": "string"
        },
        "attempt": {
          "type": "integer"
        },
        "deadline": {
          "description": "An RFC 3339 time.",
          "type": "string"
        },
        "initiator": {
          "$ref": "#/$defs/Owner"
        },
        "job": {
          "type": "string"
        },
        "jobUID": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "step": {
          "type": "integer"
        }
      },
      "required": [
        "operation",
        "job",
        "jobUID",
        "app",
        "step",
        "attempt",
        "deadline"
      ],
      "type": "object"
    },
    "Owner": {
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "type": "string"
        },
        "sub": {
          "type": "string"
        }
      },
      "required": [
        "issuer",
        "sub"
      ],
      "type": "object"
    },
    "Principal": {
      "additionalProperties": false,
      "properties": {
        "act": {
          "additionalProperties": {},
          "description": "The delegation claim of RFC 8693 §4.1.",
          "type": "object"
        },
        "claims": {
          "additionalProperties": {},
          "description": "The identity provider's other claims about the person.",
          "type": "object"
        },
        "client_id": {
          "minLength": 1,
          "type": "string"
        },
        "iss": {
          "minLength": 1,
          "type": "string"
        },
        "scope": {
          "description": "Space-separated scope tokens.",
          "type": "string"
        },
        "sub": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "iss",
        "sub",
        "client_id"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The payload of the compact JWS in X-Holon-Context. The waypoint verifies its signature before an app sees it.",
  "properties": {
    "aud": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "exp": {
      "type": "integer"
    },
    "flowId": {
      "minLength": 1,
      "type": "string"
    },
    "hook": {
      "$ref": "#/$defs/HookInvocation",
      "description": "Present for an authorized lifecycle hook invocation."
    },
    "iat": {
      "type": "integer"
    },
    "iss": {
      "enum": [
        "urn:holon:identity"
      ],
      "type": "string"
    },
    "principal": {
      "$ref": "#/$defs/Principal",
      "description": "Absent when no person or client is signed in."
    },
    "sub": {
      "description": "The session's UID.",
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "iss",
    "sub",
    "aud",
    "exp",
    "iat",
    "flowId"
  ],
  "title": "Claims",
  "type": "object"
}
