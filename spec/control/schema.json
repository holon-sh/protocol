          "$ref": "#/$defs/Boolean",
          "description": "Writes only if nothing exists yet."
        },
        "expectedRevision": {
          "$ref": "#/$defs/Revision",
          "description": "Writes only at this revision."
        },
        "policy": {
          "$ref": "#/$defs/AppEgressPolicy"
        }
      },
      "required": [
        "app",
        "policy"
      ],
      "type": "object"
    },
    "SetValueRequest": {
      "additionalProperties": false,
      "properties": {
        "apps": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "items": {
                "$ref": "#/$defs/AppName"
              },
              "type": "array",
              "uniqueItems": true
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/VariableKind"
        },
        "note": {
          "type": "string"
        },
        "revision": {
          "description": "The revision of a listed value that this one replaces.",
          "type": "string"
        },
        "session": {
          "$ref": "#/$defs/SessionName"
        },
        "value": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/InputValue"
            }
          ]
        },
        "variable": {
          "$ref": "#/$defs/EnvName"
        }
      },
      "required": [
        "apps",
        "kind",
        "variable"
      ],
      "type": "object"
    },
    "Template": {
      "maxLength": 4096,
      "not": {
        "pattern": "[\\x00\\r\\n]"
      },
      "type": "string"
