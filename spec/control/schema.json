          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "LifecycleStatus": {
      "additionalProperties": false,
      "properties": {
        "app": {
          "type": "string"
        },
        "attempt": {
          "type": "integer"
        },
        "deadline": {
          "type": "string"
        },
        "hook": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "job": {
          "type": "string"
        },
        "jobUID": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/Phase"
        },
        "readyApps": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "retry": {
          "type": "integer"
        },
        "step": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "phase",
        "step",
        "attempt"
      ],
      "type": "object"
    },
    "MCPName": {
      "maxLength": 1024,
      "minLength": 1,
      "not": {
        "pattern": "[\\x00\\r\\n]"
      },
      "type": "string"
