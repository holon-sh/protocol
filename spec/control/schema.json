              },
              "type": "array"
            }
          ]
        },
        "buildArchitectures": {
          "items": {
            "$ref": "#/$defs/Architecture"
          },
          "type": "array"
        },
        "conditions": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "items": {
                "$ref": "#/$defs/Condition"
              },
              "type": "array"
            }
          ]
        },
        "detached": {
          "$ref": "#/$defs/Boolean"
        },
        "endpoints": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "items": {
                "$ref": "#/$defs/SessionEndpoint"
              },
              "type": "array"
            }
          ]
        },
        "expiresAt": {
          "type": "string"
        },
        "generation": {
          "type": "integer"
        },
        "lifecycle": {
          "$ref": "#/$defs/LifecycleStatus"
        },
        "name": {
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/LifecycleOperation"
        },
        "releases": {
          "items": {
            "$ref": "#/$defs/InstalledRelease"
          },
          "type": "array"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "uid": {
          "type": "string"
        }
      },
      "required": [
        "uid",
        "apps",
        "name",
        "endpoints",
        "conditions",
        "revision"
      ],
      "type": "object"
    },
    "SetEgressRequest": {
      "additionalProperties": false,
      "properties": {
        "app": {
          "type": "string"
