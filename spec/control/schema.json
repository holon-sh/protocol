                "image": false,
                "mount": false,
                "overlay": false,
                "port": false,
                "remote": {
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": [
                "remote"
              ]
            },
            {
              "properties": {
                "image": false,
                "port": false,
                "remote": {
                  "type": "null"
                }
              },
              "required": [
                "overlay"
              ]
            }
          ]
        },
        {
          "oneOf": [
            {
              "properties": {},
              "required": [
                "port"
              ]
            },
            {
              "properties": {
                "image": false,
                "port": false
              }
            }
          ]
        }
      ],
      "properties": {
        "access": {
          "$ref": "#/$defs/AppAccess"
        },
        "applied": {
          "additionalProperties": {
            "$ref": "#/$defs/ConfigRevision"
          },
          "description": "The revision of each value the app runs with.",
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/$defs/EnvName"
          },
          "type": "object"
        },
        "args": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "items": {
                "$ref": "#/$defs/Template"
              },
              "maxItems": 64,
              "type": "array"
            }
          ],
          "description": "Each replaces one of the image's command arguments, when every input its template names has a value."
        },
        "egress": {
          "$ref": "#/$defs/Egress"
        },
        "env": {
          "additionalProperties": {
            "$ref": "#/$defs/Input"
          },
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/$defs/EnvName"
          },
          "type": "object"
        },
        "envTemplates": {
          "additionalProperties": {
            "$ref": "#/$defs/Template"
          },
          "description": "Variables set from templates over the app's inputs, when every input a template names has a value.",
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/$defs/EnvName"
          },
          "type": "object"
        },
        "icons": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "items": {
                "$ref": "#/$defs/Icon"
              },
              "type": "array"
            }
          ]
        },
        "image": {
          "$ref": "#/$defs/ImageRef"
        },
        "imported": {
          "$ref": "#/$defs/Boolean",
          "description": "Marks an app installed from an MCP Registry package."
        },
        "mount": {
          "$ref": "#/$defs/MountPath",
          "description": "The app's browser path in production. Defaults to /<name>."
        },
        "name": {
          "$ref": "#/$defs/AppName"
        },
        "oauth": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/OAuthClient"
            }
          ]
        },
        "overlay": {
          "$ref": "#/$defs/Digest",
          "description": "The digest of a development app's server source."
        },
        "port": {
          "$ref": "#/$defs/Port",
          "description": "Required with an image, and allowed only with one."
        },
        "release": {
          "$ref": "#/$defs/Release"
        },
        "remote": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Remote"
            }
          ]
        },
        "requires": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "items": {
                "$ref": "#/$defs/AppName"
              },
              "type": "array",
              "uniqueItems": true
            }
          ]
        },
        "supplied": {
          "additionalProperties": {
            "$ref": "#/$defs/Input"
          },
          "description": "Values set for the app that it does not declare.",
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/$defs/EnvName"
          },
          "type": "object"
        }
      },
      "required": [
