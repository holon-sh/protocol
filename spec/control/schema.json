        "servingVersion": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "LifecycleOperation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "initiator": {
          "$ref": "#/$defs/Owner"
        },
