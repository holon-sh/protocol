    "UploadGrant": {
      "additionalProperties": false,
      "properties": {
        "expiresAt": {
          "type": "string"
        },
        "grant": {
          "type": "string"
        },
        "registry": {
          "type": "string"
        },
        "repositories": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            }
          ]
        }
      },
      "required": [
        "grant",
        "registry",
        "repositories",
        "expiresAt"
      ],
      "type": "object"
    },
    "UploadRequest": {
      "additionalProperties": false,
      "properties": {
        "apps": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ]
        }
      },
      "required": [
        "apps"
      ],
      "type": "object"
    },
    "VariableKind": {
      "enum": [
        "config",
        "secret"
      ],
      "type": "string"
    },
    "VariableRequest": {
      "additionalProperties": false,
      "properties": {
        "apps": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "items": {
                "$ref": "#/$defs/AppName"
              },
              "type": "array",
              "uniqueItems": true
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/VariableKind"
        },
        "session": {
          "$ref": "#/$defs/SessionName"
        },
        "variable": {
          "$ref": "#/$defs/EnvName"
        }
      },
      "required": [
        "apps",
        "kind",
        "variable"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The definitions of Holon's control contract. operations.json names the request and result of each tool."
}
